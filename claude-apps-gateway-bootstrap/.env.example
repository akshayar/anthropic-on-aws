# Claude bootstrap add-on — deployment configuration.
# Copy to .env and fill in from your deployed claude-apps-gateway stack
# (see README "Prerequisites" for where each value comes from):
#   cp .env.example .env

AWS_REGION=us-east-1

# ClaudeGatewayStack `PublicUrl` output, e.g. https://claude-gateway.internal.example.com
PUBLIC_URL=

# HTTPS :443 listener ARN of the gateway ALB (one-time lookup; see README)
LISTENER_ARN=

# Security-group id of the gateway ALB
ALB_SG_ID=

# VPC id the gateway stack deployed into
VPC_ID=

# --- OIDC token validation (the desktop app's PKCE access token) ---
# The bootstrap server validates the token as a standard OIDC resource server
# (signature via the IdP JWKS + issuer + audience + expiry). Works for Amazon
# Cognito, Microsoft Entra, Okta — any IdP with JWKS-verifiable tokens.
#
# OIDC issuer (the token `iss`). Examples:
#   Amazon Cognito : https://cognito-idp.<region>.amazonaws.com/<userPoolId>
#   Microsoft Entra: https://login.microsoftonline.com/<tenantId>/v2.0
OIDC_ISSUER=

# Expected audience / client id — the Claude Desktop PKCE public client's id.
OIDC_AUDIENCE=

# Claim that carries the audience. Default 'aud' (OIDC id tokens, Entra).
# Amazon Cognito ACCESS tokens have NO `aud` — the client id is in `client_id`,
# so for Cognito set:  OIDC_AUDIENCE_CLAIM=client_id
#OIDC_AUDIENCE_CLAIM=client_id

# Claim holding group memberships for the entitlement gate. Default 'groups'.
# For Amazon Cognito set:  OIDC_GROUPS_CLAIM=cognito:groups
#OIDC_GROUPS_CLAIM=cognito:groups

# JWKS endpoint. Optional — defaults to <OIDC_ISSUER>/.well-known/jwks.json,
# which is correct for Cognito. Set for IdPs whose JWKS path differs, e.g. Entra:
#OIDC_JWKS_URI=https://login.microsoftonline.com/<tenantId>/discovery/v2.0/keys

# Optional comma-separated extra accepted issuers.
#OIDC_ADDITIONAL_ISSUERS=

# --- Optional: authorization gate (README "Restricting who receives configuration") ---
# Comma-separated. When set, a valid token must also carry a matching value in the
# groups claim (OIDC_GROUPS_CLAIM) / roles claim, or the request is refused with 403.
# Leave empty to serve every valid token from the issuer.
#OIDC_REQUIRED_GROUPS=engineering
#OIDC_REQUIRED_ROLES=
