# The maintainers' pre-bump drift checklist and its tooling, both local-only.
# Anthropic's config reference and CHANGELOG are the source of truth for per-feature
# version gates, so the example links them rather than keeping a copy that goes stale.
# (Anchored: /scripts/ does not affect the tracked cdk/scripts/.)
/docs/upstream-watch.md
/scripts/

# Architecture decision records are kept local to the maintainers' repo, not
# shipped with the example. Rationale lives inline in the docs and comments.
/docs/adr/
# Local-only telemetry test scratch — never shipped with the example.
/local-test/
/test-direct-otlp/

# Account-specific deploy env files (real infra values + OIDC secret placeholder).
# The tracked template is .env.example; ignore .env and any .env.<suffix>.
/cdk/.env.558
/cdk/.env.*
!/cdk/.env.example

# Customer-named / customer-specific docs must never be checked in to GitHub.
# tata-aig-demo (and any named-customer folder) is kept local only; the preserved
# off-git copies live under docs/_private-customer/.
/docs/tata-aig-demo/
/docs/_private-customer/
